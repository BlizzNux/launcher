{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlizzNux",
  "version": "0.2.0",
  "identifier": "com.blizznux.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BlizzNux",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Game",
    "shortDescription": "Battle.net games on Linux through Proton, no Steam needed",
    "longDescription": "BlizzNux installs, imports and launches Battle.net through Proton via umu-launcher, with the latest BlizzNux updates and the community forum built in. Not affiliated with Blizzard Entertainment.",
    "resources": [
      "../bin/blizznux-run"
    ],
    "linux": {
      "deb": {
        "depends": [
          "umu-launcher"
        ]
      },
      "rpm": {
        "depends": [
          "umu-launcher"
        ]
      }
    }
  }
}
