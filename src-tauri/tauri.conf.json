{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlizzNux",
  "version": "0.2.23",
  "identifier": "com.blizznux.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BlizzNux Launcher",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Game",
    "shortDescription": "Battle.net games on Linux through Proton, no Steam needed",
    "longDescription": "BlizzNux installs, imports and launches Battle.net through Proton via umu-launcher, with the latest BlizzNux updates and the community forum built in. Not affiliated with Blizzard Entertainment.",
    "resources": [
      "../bin/blizznux-run"
    ],
    "linux": {
      "deb": {
        "depends": [
          "curl",
          "python3",
          "xz-utils"
        ],
        "recommends": [
          "umu-launcher"
        ]
      },
      "rpm": {
        "depends": [
          "curl",
          "python3",
          "xz"
        ],
        "recommends": [
          "umu-launcher"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDQTJCRjUzNUEwNzE2QzAKUldUQUZnZGFVNytpL0tOUVhGa3c2dVo2L2VVamczeloxQU1OYzBFb1FzbStTOXV1bnBHdjFwaGYK",
      "endpoints": [
        "https://github.com/BlizzNux/launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
