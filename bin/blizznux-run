#!/usr/bin/env bash
# blizznux-run — install, import and launch Battle.net on Linux through Proton via umu-launcher.
# No Steam required. Part of the BlizzNux launcher: https://github.com/BlizzNux/launcher
# Copyright (C) 2026 Karl Bullock. Licensed under the GPL-3.0-or-later; see LICENSE.
set -euo pipefail

VERSION=0.2.17
APP=blizznux
CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/$APP
DATA_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/$APP
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/$APP
CONFIG=$CONFIG_DIR/config
# Blizzard's own download endpoint. The installer is never redistributed by this project.
INSTALLER_URL='https://www.battle.net/download/getInstallerForGame?os=win&gameProgram=BATTLENET_APP&version=Live'
LAUNCHER_REL='drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe'
# umu-launcher's own release, used when the system has none (Ubuntu, Debian and Fedora do not package it).
UMU_VERSION=1.4.4
UMU_URL=https://github.com/Open-Wine-Components/umu-launcher/releases/download/$UMU_VERSION/umu-launcher-$UMU_VERSION-zipapp.tar
UMU_SHA256=eb590691841f7fad3fc3ad8fd5db4ccb87849fe7948e62b28ece7a4ee48cc851
UMU_DIR=$DATA_DIR/umu

PREFIX=""; PROTON=""; OFFLOAD=auto; GAME=""

usage() {
	cat <<USAGE
blizznux-run $VERSION — Battle.net on Linux through Proton, no Steam needed.

Usage:
  blizznux-run [launch] [--game CODE]   Launch Battle.net (installs it first if needed).
                                        --game starts a game right away, e.g. --game WoW
  blizznux-run install                  Download Blizzard's installer and run it.
  blizznux-run import PATH              Use an existing Battle.net prefix (Steam compatdata/<id>/pfx,
                                        Lutris, Bottles) instead of installing again.
  blizznux-run dpi N                    Set the Windows DPI inside the prefix (96 = 100%, 144 = 150%).
  blizznux-run umu                      Make sure umu-launcher is available (downloads it when the
                                        system has none) and show which one is used.
  blizznux-run doctor                   Show what would be used and why.

Options:
  --prefix DIR      Prefix to use for this run (default: \$XDG_DATA_HOME/blizznux/prefix).
  --proton DIR      Proton build to use (default: Proton-CachyOS if installed, else newest GE-Proton,
                    else let umu download GE-Proton).
  --offload on|off  NVIDIA PRIME render offload (default: auto, on when a hybrid NVIDIA setup is found).

Game codes for --game: WoW, WTCG (Hearthstone), Hero (Heroes of the Storm), Pro (Overwatch),
  D3, Fen (Diablo IV), OSI (Diablo II Resurrected), S2 (StarCraft II), W3 (Warcraft III).
USAGE
}

LOGGING=""
log() { printf '[%s] %s\n' "$APP" "$*" >&2; }
die() {
	log "error: $*"
	if [[ -n $LOGGING ]] && command -v notify-send >/dev/null; then
		notify-send -a BlizzNux -i com.blizznux.launcher "BlizzNux" "$*" 2>/dev/null || true
	fi
	exit 1
}

# Started without a terminal (the app, the menu entry): the commands that run Proton keep a log
# instead of losing the output. The short commands print as usual, so the app can show their answer.
keep_log() {
	[[ ! -t 2 ]] || return 0
	mkdir -p "$CACHE_DIR"
	exec >>"$CACHE_DIR/blizznux.log" 2>&1
	printf '\n=== %s ===\n' "$(date -Is)"
	LOGGING=1
}

load_config() {
	[[ -f $CONFIG ]] || return 0
	local k v
	while IFS='=' read -r k v; do
		case $k in PREFIX|PROTON|OFFLOAD) printf -v "$k" '%s' "$v" ;; esac
	done < "$CONFIG"
}

save_config() {
	mkdir -p "$CONFIG_DIR"
	# The desktop app keeps its own keys (account, report settings) in the same file: carry them over.
	local keep=""
	[[ -f $CONFIG ]] && keep=$(grep -vE '^(PREFIX|PROTON|OFFLOAD)=' "$CONFIG" || true)
	{ printf 'PREFIX=%s\nPROTON=%s\nOFFLOAD=%s\n' "$PREFIX" "$PROTON" "$OFFLOAD"; [[ -z $keep ]] || printf '%s\n' "$keep"; } > "$CONFIG"
}

find_proton() {
	if [[ -n $PROTON ]]; then
		[[ -x $PROTON/proton ]] || die "no Proton build at $PROTON"
		echo "$PROTON"; return
	fi
	local d
	for d in /usr/share/steam/compatibilitytools.d/proton-cachyos*; do
		[[ -x $d/proton ]] && { echo "$d"; return; }
	done
	d=$(ls -d "$HOME"/.local/share/Steam/compatibilitytools.d/GE-Proton* 2>/dev/null | sort -V | tail -1 || true)
	[[ -n $d && -x $d/proton ]] && { echo "$d"; return; }
	echo "GE-Proton"   # umu-launcher downloads the latest GE-Proton on first use
}

hybrid_nvidia() {
	[[ -d /proc/driver/nvidia ]] || return 1
	(( $(ls /dev/dri/ 2>/dev/null | grep -c '^card') >= 2 ))
}

gpu_env() {
	# The NVIDIA driver stops storing shaders once its shared cache reaches the size limit, and a large
	# game then compiles the rest again at every start. The launcher keeps its own cache with a 10 GB
	# limit, in a folder no other program cleans up. Values set by the user win.
	if [[ -d /proc/driver/nvidia ]]; then
		export __GL_SHADER_DISK_CACHE_PATH=${__GL_SHADER_DISK_CACHE_PATH:-$CACHE_DIR/shader-cache}
		export __GL_SHADER_DISK_CACHE_SIZE=${__GL_SHADER_DISK_CACHE_SIZE:-10737418240}
		export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=${__GL_SHADER_DISK_CACHE_SKIP_CLEANUP:-1}
		mkdir -p "$__GL_SHADER_DISK_CACHE_PATH" 2>/dev/null || true
		# The driver keeps every shader pipeline DXVK creates in memory, and a large game grew to 19 GB
		# that way. Let DXVK free the ones a game no longer uses. A DXVK_CONFIG set by the user wins.
		export DXVK_CONFIG="${DXVK_CONFIG:-dxvk.trackPipelineLifetime = True}"
	fi
	case $OFFLOAD in
	off) return ;;
	on) ;;
	*) hybrid_nvidia || return ;;
	esac
	export __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only
}

ensure_prefix() {
	[[ -n $PREFIX ]] || PREFIX=$DATA_DIR/prefix
	mkdir -p "$PREFIX"
	[[ -f $CONFIG ]] || save_config
}

fetch_umu() {
	command -v python3 >/dev/null || die "python3 is needed to run umu-launcher"
	log "umu-launcher is not installed; downloading version $UMU_VERSION from its GitHub release"
	local tmp; tmp=$(mktemp -d)
	curl -fL --retry 3 -sS -o "$tmp/umu.tar" "$UMU_URL" || die "could not download umu-launcher"
	echo "$UMU_SHA256  $tmp/umu.tar" | sha256sum -c --quiet - || die "the umu-launcher download is damaged (checksum mismatch)"
	tar -xf "$tmp/umu.tar" -C "$tmp"
	mkdir -p "$UMU_DIR"
	install -m755 "$tmp/umu/umu-run" "$UMU_DIR/umu-run"
	[[ ! -f $tmp/umu/umu_run.py ]] || install -m755 "$tmp/umu/umu_run.py" "$UMU_DIR/umu_run.py"
	rm -rf "$tmp"
}

# umu-run to use: the system's, else the launcher's own copy (downloaded on first use).
find_umu() {
	if command -v umu-run >/dev/null; then command -v umu-run; return; fi
	[[ -x $UMU_DIR/umu-run ]] || fetch_umu
	echo "$UMU_DIR/umu-run"
}

run_umu() {
	local umu; umu=$(find_umu)
	local proton; proton=$(find_proton)
	export WINEPREFIX=$PREFIX PROTONPATH=$proton GAMEID=${GAMEID:-umu-default} STORE=none PROTON_VERB=waitforexitandrun
	gpu_env
	local inhibit=()
	command -v systemd-inhibit >/dev/null && inhibit=(systemd-inhibit --what=idle:sleep --why="Battle.net is running")
	log "proton: $proton"; log "prefix: $PREFIX"
	"${inhibit[@]}" "$umu" "$@"
}

cmd_install() {
	ensure_prefix
	if [[ -f $PREFIX/$LAUNCHER_REL ]]; then log "Battle.net is already installed in $PREFIX"; return; fi
	mkdir -p "$CACHE_DIR"
	local setup=$CACHE_DIR/Battle.net-Setup.exe
	log "downloading the Battle.net installer from Blizzard"
	curl -fL --retry 3 --progress-bar -o "$setup" "$INSTALLER_URL"
	log "running the installer: sign in, let it finish, then close Battle.net"
	run_umu "$setup"
	[[ -f $PREFIX/$LAUNCHER_REL ]] || die "the installer finished but Battle.net was not found; run 'blizznux-run install' again"
	log "installed"
}

cmd_import() {
	local src=${1:?usage: blizznux-run import PATH}
	[[ -f $src/$LAUNCHER_REL ]] || die "no Battle.net installation under $src (expected $LAUNCHER_REL)"
	PREFIX=$(realpath "$src")
	save_config
	log "using existing prefix: $PREFIX"
}

cmd_dpi() {
	local n=${1:?usage: blizznux-run dpi N}
	[[ $n =~ ^[0-9]+$ ]] || die "dpi must be a number, e.g. 144"
	ensure_prefix
	run_umu reg add 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$n" /f
	run_umu reg add 'HKCU\Software\Wine\Fonts' /v LogPixels /t REG_DWORD /d "$n" /f
	log "DPI set to $n"
}

cmd_launch() {
	ensure_prefix
	[[ -f $PREFIX/$LAUNCHER_REL ]] || cmd_install
	if [[ -n $GAME ]]; then
		run_umu "$PREFIX/$LAUNCHER_REL" --exec="launch $GAME"
	else
		run_umu "$PREFIX/$LAUNCHER_REL"
	fi
}

cmd_umu() {
	local umu; umu=$(find_umu)
	echo "$umu $("$umu" --version 2>/dev/null | head -1)"
}

cmd_doctor() {
	ensure_prefix
	local umu; umu=$(command -v umu-run || true)
	[[ -n $umu || ! -x $UMU_DIR/umu-run ]] || umu=$UMU_DIR/umu-run
	echo "blizznux-run $VERSION"
	if [[ -n $umu ]]; then
		echo "umu-run:   $umu $("$umu" --version 2>/dev/null | head -1)"
	else
		echo "umu-run:   not installed (downloaded on first use)"
	fi
	echo "proton:    $(find_proton)"
	echo "prefix:    $PREFIX $([[ -f $PREFIX/$LAUNCHER_REL ]] && echo '(Battle.net installed)' || echo '(Battle.net not installed)')"
	echo "offload:   $OFFLOAD $(hybrid_nvidia && echo '(hybrid NVIDIA detected)' || echo '(no hybrid NVIDIA)')"
	echo "config:    $CONFIG"
}

load_config
cmd=launch
while (( $# )); do
	case $1 in
	launch|install|import|dpi|umu|doctor) cmd=$1 ;;
	--game) GAME=${2:?--game needs a code}; shift ;;
	--prefix) PREFIX=${2:?--prefix needs a directory}; shift ;;
	--proton) PROTON=${2:?--proton needs a directory}; shift ;;
	--offload) OFFLOAD=${2:?--offload needs on|off|auto}; shift ;;
	-h|--help) usage; exit 0 ;;
	-V|--version) echo "$VERSION"; exit 0 ;;
	*) break ;;
	esac
	shift
done
case $cmd in
launch) keep_log; cmd_launch ;;
install) keep_log; cmd_install ;;
import) cmd_import "${1:-}" ;;
dpi) keep_log; cmd_dpi "${1:-}" ;;
umu) cmd_umu ;;
doctor) cmd_doctor ;;
esac
