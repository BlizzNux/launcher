#!/usr/bin/env bash
# blizznux-run — install and launch Battle.net on Linux through Proton via umu-launcher.
# No Steam required. Part of the BlizzNux launcher: https://github.com/BlizzNux/launcher
# Copyright (C) 2026 Karl Bullock. Licensed under the GPL-3.0-or-later; see LICENSE.
set -euo pipefail

VERSION=0.2.42
APP=blizznux
CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/$APP
DATA_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/$APP
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/$APP
CONFIG=$CONFIG_DIR/config
# Blizzard's own download endpoint. The installer is never redistributed by this project.
INSTALLER_URL='https://www.battle.net/download/getInstallerForGame?os=win&gameProgram=BATTLENET_APP&version=Live'
LAUNCHER_REL='drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe'
LAUNCHER_WIN='C:\Program Files (x86)\Battle.net\Battle.net Launcher.exe'
# The umu-launcher release every install runs, kept in the launcher's data folder. A umu-launcher of the
# system is not used: every distribution has another version, or none. Change the version and the checksum
# together, here and in the Flatpak manifest, which carries the same release.
UMU_VERSION=1.4.4
UMU_URL=https://github.com/Open-Wine-Components/umu-launcher/releases/download/$UMU_VERSION/umu-launcher-$UMU_VERSION-zipapp.tar
UMU_SHA256=eb590691841f7fad3fc3ad8fd5db4ccb87849fe7948e62b28ece7a4ee48cc851
UMU_DIR=$DATA_DIR/umu
# The Proton build every install runs on: Proton-CachyOS's own release for
# any distribution, kept in the launcher's data folder. It moves to a newer build only after Blizzard's
# games ran on that one; change the version, the checksum and the size together.
PROTON_VERSION=cachyos-11.0-20261015-slr
PROTON_NAME=proton-$PROTON_VERSION-x86_64
PROTON_URL=https://github.com/CachyOS/proton-cachyos/releases/download/$PROTON_VERSION/$PROTON_NAME.tar.xz
PROTON_SHA256=35e16eab636724e3ed7aa8e2dbc33eb8e102e0c63bbc28b5a39af544c75d5bd3
PROTON_MB=332
PROTON_DIR=$DATA_DIR/proton

PREFIX=""; OFFLOAD=auto; GAME=""; LAB_WOW64=0; LAB_PROTON_DIR=""; LAB_DIRECT_PROTON=0

usage() {
	cat <<USAGE
blizznux-run $VERSION — Battle.net on Linux through Proton, no Steam needed.

Usage:
  blizznux-run [launch] [--game CODE]   Launch Battle.net (installs it first if needed).
                                        --game starts a game right away, e.g. --game WoW
  blizznux-run install                  Download Blizzard's installer and run it.
  blizznux-run dpi N                    Set the Windows DPI inside the prefix (96 = 100%, 144 = 150%).
  blizznux-run umu                      Make sure the launcher's umu-launcher is there (downloads it
                                        on first use) and show it.
  blizznux-run proton                   Make sure the launcher's Proton is there (downloads it on
                                        first use) and show it.
  blizznux-run doctor                   Show what would be used and why.

Options:
  --offload on|off  NVIDIA PRIME render offload (default: auto, on when a hybrid NVIDIA setup is found).

Game codes for --game: WoW, WTCG (Hearthstone), Hero (Heroes of the Storm), Pro (Overwatch),
  D3, Fen (Diablo IV), OSI (Diablo II Resurrected), S2 (StarCraft II), W3 (Warcraft III).
USAGE
}

LOGGING=""
log() { printf '[%s] %s\n' "$APP" "$*" >&2; }
die() {
	log "error: $*"
	if [[ -n $LOGGING ]] && command -v notify-send >/dev/null; then
		notify-send -a BlizzNux -i com.blizznux.launcher "BlizzNux" "$*" 2>/dev/null || true
	fi
	exit 1
}

# Started without a terminal (the app, the menu entry): the commands that run Proton keep a log
# instead of losing the output. The short commands print as usual, so the app can show their answer.
keep_log() {
	[[ ! -t 2 ]] || return 0
	mkdir -p "$CACHE_DIR"
	exec >>"$CACHE_DIR/blizznux.log" 2>&1
	printf '\n=== %s ===\n' "$(date -Is)"
	LOGGING=1
}

load_config() {
	[[ -f $CONFIG ]] || return 0
	local k v
	while IFS='=' read -r k v; do
		case $k in PREFIX|OFFLOAD|LAB_WOW64|LAB_PROTON_DIR|LAB_DIRECT_PROTON) printf -v "$k" '%s' "$v" ;; esac
	done < "$CONFIG"
}

save_config() {
	mkdir -p "$CONFIG_DIR"
	# The desktop app keeps its own keys (account, report settings) in the same file: carry them over.
	# A Proton build chosen with an earlier version is dropped: the launcher's own is the only one now.
	local keep=""
	[[ -f $CONFIG ]] && keep=$(grep -vE '^(PREFIX|PROTON|OFFLOAD|LAB_WOW64|LAB_PROTON_DIR|LAB_DIRECT_PROTON)=' "$CONFIG" || true)
	{ printf 'PREFIX=%s\nOFFLOAD=%s\n' "$PREFIX" "$OFFLOAD"; [[ $LAB_WOW64 != 1 ]] || printf 'LAB_WOW64=1\n'; [[ -z $LAB_PROTON_DIR ]] || printf 'LAB_PROTON_DIR=%s\n' "$LAB_PROTON_DIR"; [[ $LAB_DIRECT_PROTON != 1 ]] || printf 'LAB_DIRECT_PROTON=1\n'; [[ -z $keep ]] || printf '%s\n' "$keep"; } > "$CONFIG"
}

proton_sum_ok() { echo "$PROTON_SHA256  $1" | sha256sum -c --quiet - >/dev/null 2>&1; }

# Downloads the Proton archive to $1, continuing a file that is already partly there.
download_proton() {
	curl -fL --retry 3 -sS -C - -o "$1" "$PROTON_URL" &
	local pid=$!
	while kill -0 "$pid" 2>/dev/null; do
		sleep 5
		log "Proton: $(( $(stat -c %s "$1" 2>/dev/null || echo 0) / 1048576 )) of $PROTON_MB MB"
	done
	wait "$pid"
}

fetch_proton() {
	command -v xz >/dev/null || die "xz is needed to unpack Proton (install the xz or xz-utils package)"
	mkdir -p "$PROTON_DIR"
	local part=$PROTON_DIR/$PROTON_NAME.tar.xz.part
	if ! proton_sum_ok "$part"; then
		log "downloading Proton $PROTON_VERSION (about $PROTON_MB MB)"
		local rc=0
		download_proton "$part" || rc=$?
		if (( rc == 22 || rc == 33 )); then
			# The server will not continue this file (it is all there but damaged): fetch it from the start.
			rm -f "$part"; rc=0
			download_proton "$part" || rc=$?
		fi
		(( rc == 0 )) || die "could not download Proton"
		if ! proton_sum_ok "$part"; then
			rm -f "$part"
			die "the Proton download is damaged (checksum mismatch); start again to download it afresh"
		fi
	fi
	log "unpacking Proton"
	local tmp=$PROTON_DIR/.unpack
	rm -rf "$tmp"
	mkdir -p "$tmp"
	tar -xf "$part" -C "$tmp" || die "could not unpack Proton"
	# An earlier build of the launcher's own Proton is not needed any more, unless Battle.net still runs on it.
	if ! pgrep -f "$PROTON_DIR/" >/dev/null 2>&1; then
		find "$PROTON_DIR" -mindepth 1 -maxdepth 1 -name 'proton-*' ! -name "$PROTON_NAME.tar.xz.part" -exec rm -rf {} +
	fi
	rm -rf "${PROTON_DIR:?}/$PROTON_NAME"
	mv "$tmp/$PROTON_NAME" "$PROTON_DIR/$PROTON_NAME"
	rm -rf "$tmp" "$part"
}

# Labs: a Proton build already on this computer. BLIZZNUX_PROTON (a packager's override, not in the
# app) wins over the folder chosen in Settings > Labs. Prints the folder, or nothing when neither is set.
custom_proton() {
	local d=${BLIZZNUX_PROTON:-}
	[[ -n $d ]] || d=$LAB_PROTON_DIR
	printf '%s' "${d%/}"
}

# Where the custom Proton came from, for messages.
custom_proton_source() {
	if [[ -n ${BLIZZNUX_PROTON:-} ]]; then echo "BLIZZNUX_PROTON"; else echo "Labs"; fi
}

# Proton to use: the launcher's own build, downloaded on first use. A Proton of the system is not
# used: it changes with every system update, and no two machines would run the same one. Unless the
# user asked for one in Labs (or a packager with BLIZZNUX_PROTON): then that one, or an error, never
# a quiet fall back to the download.
find_proton() {
	local custom; custom=$(custom_proton)
	if [[ -n $custom ]]; then
		[[ -f $custom/proton && -x $custom/proton ]] || die "the Proton you chose ($(custom_proton_source): $custom) is not usable: the folder must hold an executable file named proton"
		echo "$custom"
		return
	fi
	[[ -x $PROTON_DIR/$PROTON_NAME/proton ]] || fetch_proton >&2   # callers read the path from stdout
	echo "$PROTON_DIR/$PROTON_NAME"
}

hybrid_nvidia() {
	[[ -d /proc/driver/nvidia ]] || return 1
	(( $(ls /dev/dri/ 2>/dev/null | grep -c '^card') >= 2 ))
}

# The chip that drives the screen on a hybrid NVIDIA laptop, as a DXVK device-name filter ("AMD"
# or "Intel"). Prints nothing unless the machine is clearly that: exactly two GPUs, one NVIDIA and
# one AMD or Intel that the firmware started the display on (boot_vga), with a Vulkan driver
# installed for it. Anything else, or anything unreadable, prints nothing.
hybrid_display_gpu() {
	local drm=${BLIZZNUX_DRM_DIR:-/sys/class/drm} card vendor gpus=0 nvidia=0 display="" name icd f
	for card in "$drm"/card*; do
		[[ $card =~ /card[0-9]+$ && -r $card/device/vendor ]] || continue
		gpus=$((gpus + 1))
		vendor=$(cat "$card/device/vendor" 2>/dev/null) || return 0
		case $vendor in
		0x10de) nvidia=$((nvidia + 1)) ;;
		0x1002 | 0x8086) [[ $(cat "$card/device/boot_vga" 2>/dev/null) == 1 ]] && display=$vendor ;;
		esac
	done
	((gpus == 2 && nvidia == 1)) || return 0
	case $display in
	0x1002) name=AMD icd=radeon ;;
	0x8086) name=Intel icd=intel ;;
	*) return 0 ;;
	esac
	for f in ${BLIZZNUX_ICD_DIRS:-/usr/share/vulkan/icd.d /etc/vulkan/icd.d /usr/local/share/vulkan/icd.d /usr/lib/x86_64-linux-gnu/GL/vulkan/icd.d}; do
		compgen -G "$f/${icd}_icd*.json" >/dev/null && { echo "$name"; return 0; }
	done
	return 0
}

gpu_env() {
	# The NVIDIA driver stops storing shaders once its shared cache reaches the size limit, and a large
	# game then compiles the rest again at every start. The launcher keeps its own cache with a 10 GB
	# limit, in a folder no other program cleans up. Values set by the user win.
	if [[ -d /proc/driver/nvidia ]]; then
		export __GL_SHADER_DISK_CACHE_PATH=${__GL_SHADER_DISK_CACHE_PATH:-$CACHE_DIR/shader-cache}
		export __GL_SHADER_DISK_CACHE_SIZE=${__GL_SHADER_DISK_CACHE_SIZE:-10737418240}
		export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=${__GL_SHADER_DISK_CACHE_SKIP_CLEANUP:-1}
		mkdir -p "$__GL_SHADER_DISK_CACHE_PATH" 2>/dev/null || true
		# The driver keeps every shader pipeline DXVK creates in memory, and a large game grew to 19 GB
		# that way. Let DXVK free the ones a game no longer uses. A DXVK_CONFIG set by the user wins.
		export DXVK_CONFIG="${DXVK_CONFIG:-dxvk.trackPipelineLifetime = True}"
	fi
	case $OFFLOAD in
	off) return 0 ;;
	on) ;;
	*) hybrid_nvidia || return 0 ;;   # a plain return would stop the script under set -e
	esac
	export __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia
	# Under Hyprland, Battle.net's window could stay white: its UI (Chromium, drawn through DXVK)
	# rendered on the NVIDIA chip and failed to hand frames to the screen on the other chip. There
	# Battle.net.exe draws on the display chip, and games are kept on NVIDIA through DXVK and
	# vkd3d's own device filters instead of hiding the display chip from every program. Only when
	# the launcher set DXVK_CONFIG itself and the hardware is clearly a two-GPU laptop; everyone
	# else keeps NVIDIA_only, as before.
	local display=""
	if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} && ${DXVK_CONFIG:-} == "dxvk.trackPipelineLifetime = True" ]]; then
		display=$(hybrid_display_gpu)
	fi
	if [[ -n $display ]]; then
		export DXVK_CONFIG="$DXVK_CONFIG; dxvk.deviceFilter = NVIDIA; [Battle.net.exe]; dxvk.deviceFilter = $display"
		export VKD3D_FILTER_DEVICE_NAME=${VKD3D_FILTER_DEVICE_NAME:-NVIDIA}
		log "hybrid GPU under Hyprland: Battle.net's window draws on the $display chip, games on NVIDIA"
	else
		export __VK_LAYER_NV_optimus=NVIDIA_only
	fi
}

ensure_prefix() {
	[[ -n $PREFIX ]] || PREFIX=$DATA_DIR/prefix
	mkdir -p "$PREFIX"
	[[ -f $CONFIG ]] || save_config
}

fetch_umu() {
	command -v python3 >/dev/null || die "python3 is needed to run umu-launcher"
	log "downloading umu-launcher $UMU_VERSION"
	local tmp; tmp=$(mktemp -d)
	curl -fL --retry 3 -sS -o "$tmp/umu.tar" "$UMU_URL" || die "could not download umu-launcher"
	echo "$UMU_SHA256  $tmp/umu.tar" | sha256sum -c --quiet - || die "the umu-launcher download is damaged (checksum mismatch)"
	tar -xf "$tmp/umu.tar" -C "$tmp"
	mkdir -p "$UMU_DIR"
	install -m755 "$tmp/umu/umu-run" "$UMU_DIR/umu-run"
	[[ ! -f $tmp/umu/umu_run.py ]] || install -m755 "$tmp/umu/umu_run.py" "$UMU_DIR/umu_run.py"
	echo "$UMU_VERSION" > "$UMU_DIR/version"
	rm -rf "$tmp"
}

# The launcher's own umu-run if it is there: the one inside the Flatpak, else the downloaded release
# of the version above.
own_umu() {
	if [[ -n ${FLATPAK_ID:-} && -x /app/bin/umu-run ]]; then echo /app/bin/umu-run; return; fi
	[[ -x $UMU_DIR/umu-run && $(cat "$UMU_DIR/version" 2>/dev/null) == "$UMU_VERSION" ]] && echo "$UMU_DIR/umu-run"
}

# umu-run to use: the launcher's own, downloaded on first use.
find_umu() {
	own_umu || { fetch_umu >&2; echo "$UMU_DIR/umu-run"; }   # callers read the path from stdout
}

# Exports BLIZZNUX_LAB, the Labs settings in effect (comma separated, sorted), and what they need.
labs_env() {
	local labs=()
	[[ $LAB_DIRECT_PROTON != 1 ]] || labs+=(direct)
	[[ -z $(custom_proton) ]] || labs+=(proton)
	if [[ $LAB_WOW64 == 1 ]]; then
		labs+=(wow64)
		export PROTON_USE_WOW64=1
		log "Labs: Wine WoW64 mode on (PROTON_USE_WOW64=1)"
	fi
	if [[ $LAB_WOW64 != 1 && ${PROTON_USE_WOW64:-} == 1 ]]; then
		# Set by hand in the environment: the same mode, so reports must be marked Labs too.
		labs+=(wow64)
		log "Labs: Wine WoW64 mode on (PROTON_USE_WOW64=1 set in the environment)"
	fi
	[[ -z $(custom_proton) ]] || log "Labs: using the installed Proton $(custom_proton) ($(custom_proton_source))"
	[[ $LAB_DIRECT_PROTON != 1 ]] || log "Labs: running Proton directly, without umu-launcher's container"
	(( ${#labs[@]} )) || return 0
	local IFS=,
	export BLIZZNUX_LAB="${labs[*]}"
}

# Labs: Proton without umu. Proton wants the prefix as a Steam "compat data" folder holding a pfx
# folder. umu-launcher 1.4.4 uses the prefix itself as that folder and makes pfx a symlink to "."
# inside it, so the same prefix serves both ways and nothing is moved.
direct_setup() {
	mkdir -p "$PREFIX/shadercache" "$PREFIX/gstreamer-1.0" "$DATA_DIR/steam"
	[[ ! -L $PREFIX/pfx ]] || rm -f "$PREFIX/pfx"
	[[ -d $PREFIX/pfx ]] || ln -s . "$PREFIX/pfx"
	touch "$PREFIX/tracked_files"
}

run_direct() {
	local proton; proton=$(find_proton)
	direct_setup
	local appid=0
	[[ ${GAMEID:-umu-default} =~ ^umu-([[:alnum:]_]+)$ ]] && appid=${BASH_REMATCH[1]}
	export WINEPREFIX=$PREFIX STEAM_COMPAT_DATA_PATH=$PREFIX STEAM_COMPAT_SHADER_PATH=$PREFIX/shadercache \
		STEAM_COMPAT_CLIENT_INSTALL_PATH=$DATA_DIR/steam SteamAppId=$appid SteamGameId=$appid
	gpu_env
	labs_env
	local inhibit=()
	command -v systemd-inhibit >/dev/null && inhibit=(systemd-inhibit --what=idle:sleep --why="Battle.net is running")
	log "proton: $proton (direct)"; log "prefix: $PREFIX"
	"${inhibit[@]}" "$proton/proton" waitforexitandrun "$@"
}

run_umu() {
	if [[ $LAB_DIRECT_PROTON == 1 ]]; then run_direct "$@"; return; fi
	local umu; umu=$(find_umu)
	local proton; proton=$(find_proton)
	export WINEPREFIX=$PREFIX PROTONPATH=$proton GAMEID=${GAMEID:-umu-default} STORE=none PROTON_VERB=waitforexitandrun
	gpu_env
	# Labs (experimental, opt-in). BLIZZNUX_LAB tells the launcher which were on for this session.
	labs_env
	local inhibit=()
	command -v systemd-inhibit >/dev/null && inhibit=(systemd-inhibit --what=idle:sleep --why="Battle.net is running")
	log "proton: $proton"; log "prefix: $PREFIX"
	"${inhibit[@]}" "$umu" "$@"
}

cmd_install() {
	ensure_prefix
	if [[ -f $PREFIX/$LAUNCHER_REL ]]; then log "Battle.net is already installed in $PREFIX"; return; fi
	mkdir -p "$CACHE_DIR"
	local setup=$CACHE_DIR/Battle.net-Setup.exe
	log "downloading the Battle.net installer from Blizzard"
	curl -fL --retry 3 --progress-bar -o "$setup" "$INSTALLER_URL"
	log "running the installer: sign in when it asks; Battle.net opens when it is done"
	if [[ $LAB_DIRECT_PROTON == 1 ]]; then
		# Without umu, Proton hands a path outside the prefix to a shim that is not there: run a copy inside it.
		mkdir -p "$PREFIX/drive_c"
		cp -f "$setup" "$PREFIX/drive_c/blizznux-setup.exe"
		run_umu 'C:\blizznux-setup.exe'
	else
		run_umu "$setup"
	fi
	[[ -f $PREFIX/$LAUNCHER_REL ]] || die "the installer finished but Battle.net was not found; run 'blizznux-run install' again"
	log "installed"
}

cmd_dpi() {
	local n=${1:?usage: blizznux-run dpi N}
	[[ $n =~ ^[0-9]+$ ]] || die "dpi must be a number, e.g. 144"
	ensure_prefix
	run_umu reg add 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$n" /f
	run_umu reg add 'HKCU\Software\Wine\Fonts' /v LogPixels /t REG_DWORD /d "$n" /f
	log "DPI set to $n"
}

cmd_launch() {
	ensure_prefix
	[[ -f $PREFIX/$LAUNCHER_REL ]] || cmd_install
	local exe=$PREFIX/$LAUNCHER_REL
	[[ $LAB_DIRECT_PROTON != 1 ]] || exe=$LAUNCHER_WIN   # direct mode starts it by its Windows path
	if [[ -n $GAME ]]; then
		run_umu "$exe" --exec="launch $GAME"
	else
		run_umu "$exe"
	fi
}

cmd_umu() {
	local umu; umu=$(find_umu)
	echo "$umu $("$umu" --version 2>/dev/null | head -1)"
}

cmd_proton() {
	local proton; proton=$(find_proton)
	echo "$proton $(awk '{print $NF; exit}' "$proton/version" 2>/dev/null)"
}

cmd_doctor() {
	ensure_prefix
	local umu; umu=$(own_umu || true)
	echo "blizznux-run $VERSION"
	if [[ $LAB_DIRECT_PROTON == 1 ]]; then
		echo "mode:      Proton directly, without umu-launcher (Labs)"
	elif [[ -n $umu ]]; then
		echo "umu-run:   $umu $("$umu" --version 2>/dev/null | head -1)"
	else
		echo "umu-run:   $UMU_VERSION (downloaded on first use)"
	fi
	if [[ -n $(custom_proton) ]]; then
		echo "proton:    $(custom_proton) (from $(custom_proton_source)$([[ -x $(custom_proton)/proton ]] || echo '; NOT usable: no executable proton file'))"
	elif [[ -x $PROTON_DIR/$PROTON_NAME/proton ]]; then
		echo "proton:    $PROTON_DIR/$PROTON_NAME"
	else
		echo "proton:    $PROTON_VERSION (downloaded on first use)"
	fi
	echo "prefix:    $PREFIX $([[ -f $PREFIX/$LAUNCHER_REL ]] && echo '(Battle.net installed)' || echo '(Battle.net not installed)')"
	echo "offload:   $OFFLOAD $(hybrid_nvidia && echo '(hybrid NVIDIA detected)' || echo '(no hybrid NVIDIA)')"
	echo "config:    $CONFIG"
}

load_config
cmd=launch
while (( $# )); do
	case $1 in
	launch|install|dpi|umu|proton|doctor) cmd=$1 ;;
	import|--prefix|--proton) die "'$1' is gone: the launcher installs Battle.net itself and runs it on its own Proton" ;;
	--game) GAME=${2:?--game needs a code}; shift ;;
	--offload) OFFLOAD=${2:?--offload needs on|off|auto}; shift ;;
	-h|--help) usage; exit 0 ;;
	-V|--version) echo "$VERSION"; exit 0 ;;
	*) break ;;
	esac
	shift
done
case $cmd in
launch) keep_log; cmd_launch ;;
install) keep_log; cmd_install ;;
dpi) keep_log; cmd_dpi "${1:-}" ;;
umu) cmd_umu ;;
proton) cmd_proton ;;
doctor) cmd_doctor ;;
esac
